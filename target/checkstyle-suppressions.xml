<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
  "-//Checkstyle//DTD SuppressionList Configuration 1.2//EN"
  "https://checkstyle.sourceforge.io/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- Test files: relax Javadoc and line length requirements -->
  <suppress checks="MissingJavadocMethod" files=".*Test\.java"/>
  <suppress checks="MissingJavadocType" files=".*Test\.java"/>
  <suppress checks="LineLength" files=".*Test\.java"/>
</suppressions>
